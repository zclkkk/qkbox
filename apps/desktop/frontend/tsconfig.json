{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "isolatedModules": true,
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "bindings/**/*.js", "bindings/**/*.d.ts"]
}
